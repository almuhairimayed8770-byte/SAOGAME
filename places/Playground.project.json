{
	"name": "SkyspirePlayground",
	"globIgnorePaths": ["**/*.spec.luau", "**/selene.toml"],
	"tree": {
		"$className": "DataModel",
		"ReplicatedStorage": {
			"Shared": {
				"$path": "../src/shared"
			}
		},
		"ServerScriptService": {
			"Server": {
				"$path": "../src/server"
			}
		},
		"StarterPlayer": {
			"$properties": {
				"CharacterWalkSpeed": 16,
				"CharacterJumpPower": 50,
				"EnableMouseLockOption": false,
				"CameraMode": "Classic"
			},
			"StarterPlayerScripts": {
				"Client": {
					"$path": "../src/client"
				}
			}
		},
		"Workspace": {
			"$properties": {
				"StreamingEnabled": false,
				"FallenPartsDestroyHeight": -600,
				"Attributes": {
					"Attributes": {
						"DevCapture": { "Bool": true }
					}
				}
			},
			"Playground": {
				"$className": "Model",
				"$properties": {
					"ModelStreamingMode": "Persistent"
				},
				"Field": {
					"$className": "Part",
					"$properties": {
						"Anchored": true,
						"Shape": "Cylinder",
						"Size": [4, 400, 400],
						"CFrame": {
							"CFrame": {
								"position": [0, -2, 0],
								"orientation": [[0, 1, 0], [-1, 0, 0], [0, 0, 1]]
							}
						},
						"Material": "Grass",
						"Color": [0.33, 0.58, 0.25],
						"TopSurface": "Smooth",
						"BottomSurface": "Smooth"
					}
				},
				"Ceiling": {
					"$className": "Part",
					"$properties": {
						"Anchored": true,
						"CanCollide": false,
						"Shape": "Cylinder",
						"Size": [6, 900, 900],
						"CFrame": {
							"CFrame": {
								"position": [0, 350, 0],
								"orientation": [[0, 1, 0], [-1, 0, 0], [0, 0, 1]]
							}
						},
						"Material": "Slate",
						"Color": [0.42, 0.4, 0.38],
						"TopSurface": "Smooth",
						"BottomSurface": "Smooth"
					}
				},
				"Spawn": {
					"$className": "SpawnLocation",
					"$properties": {
						"Anchored": true,
						"Size": [8, 1, 8],
						"Position": [0, 0.5, 0],
						"Transparency": 1,
						"CanCollide": false,
						"Neutral": true,
						"Duration": 0
					}
				}
			}
		},
		"Lighting": {
			"$properties": {
				"Technology": "Future",
				"ShadowSoftness": 0.2,
				"EnvironmentDiffuseScale": 0.6,
				"EnvironmentSpecularScale": 0.3,
				"Brightness": 2,
				"ClockTime": 10,
				"GeographicLatitude": 30,
				"Ambient": [0.35, 0.37, 0.42],
				"OutdoorAmbient": [0.45, 0.5, 0.58],
				"GlobalShadows": true
			},
			"ColorCorrection": {
				"$className": "ColorCorrectionEffect",
				"$properties": {
					"Saturation": 0.15,
					"Contrast": 0.1,
					"TintColor": [1, 0.99, 0.95]
				}
			},
			"Bloom": {
				"$className": "BloomEffect",
				"$properties": {
					"Intensity": 0.4,
					"Size": 24,
					"Threshold": 0.9
				}
			},
			"SunRays": {
				"$className": "SunRaysEffect",
				"$properties": {
					"Intensity": 0.1,
					"Spread": 0.6
				}
			},
			"Atmosphere": {
				"$className": "Atmosphere",
				"$properties": {
					"Density": 0.3,
					"Haze": 1.5,
					"Glare": 0.4,
					"Color": [0.78, 0.86, 0.95],
					"Decay": [0.55, 0.65, 0.8]
				}
			},
			"Sky": {
				"$className": "Sky",
				"$properties": {
					"SunAngularSize": 14,
					"MoonAngularSize": 8,
					"StarCount": 1500
				}
			},
			"Clouds": {
				"$className": "Clouds",
				"$properties": {
					"Cover": 0.55,
					"Density": 0.3
				}
			}
		},
		"SoundService": {
			"$properties": {
				"RespectFilteringEnabled": true
			}
		}
	}
}
