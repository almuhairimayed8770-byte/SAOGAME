local El = Harness.load("src/client/ui/lib/El")
local Palette = Harness.load("src/shared/data/palette")

describe("El", function()
	it("creates an instance, sets props after creation and parents children in order", function()
		local stroke = El.new("UIStroke", { Thickness = 2 })
		local label = El.new("TextLabel", {
			Name = "Name",
			Text = "Mira",
			TextSize = 20,
			BackgroundTransparency = 1,
			Size = UDim2.fromOffset(100, 20),
		}, { stroke })
		expect(label.ClassName).toBe("TextLabel")
		expect(label.Name).toBe("Name")
		expect(label.Text).toBe("Mira")
		expect(label.TextSize).toBe(20)
		expect(label.BackgroundTransparency).toBe(1)
		expect(stroke.Parent).toBe(label)
		expect(stroke.Thickness).toBe(2)
	end)

	it("sets Parent last so a built tree is parented once", function()
		local holder = El.new("Frame", { Name = "Holder" })
		local child = El.new("Frame", { Name = "Child", Parent = holder }, { El.new("UICorner", {}) })
		expect(child.Parent).toBe(holder)
		expect(#child:GetChildren()).toBe(1)
		expect(holder:FindFirstChild("Child")).toBe(child)
	end)

	it("state cells get, set and fire changed with (new, old) only on real changes", function()
		local hp = El.state(300)
		local fired = {}
		hp.changed:Connect(function(new, old)
			table.insert(fired, { new, old })
		end)
		expect(hp.get()).toBe(300)
		hp.set(250)
		hp.set(250)
		hp.set(100)
		task.wait()
		expect(hp.get()).toBe(100)
		expect(#fired).toBe(2)
		expect(fired[1]).toEqual({ 250, 300 })
		expect(fired[2]).toEqual({ 100, 250 })
	end)

	it("bind writes the mapped value now and on every change", function()
		local label = El.new("TextLabel", { Text = "" })
		local hp = El.state(300)
		local connection = El.bind(label, "Text", hp, function(value)
			return ("%d"):format(value)
		end)
		expect(label.Text).toBe("300")
		hp.set(42)
		task.wait()
		expect(label.Text).toBe("42")
		connection:Disconnect()
		hp.set(7)
		task.wait()
		expect(label.Text).toBe("42")
	end)

	it("bind without a map writes the raw value", function()
		local frame = El.new("Frame", {})
		local visible = El.state(false)
		El.bind(frame, "Visible", visible)
		expect(frame.Visible).toBe(false)
		visible.set(true)
		task.wait()
		expect(frame.Visible).toBe(true)
	end)

	it("computed cells follow their inputs", function()
		local hp = El.state(150)
		local maxHp = El.state(300)
		local fraction = El.computed({ hp, maxHp }, function()
			return hp.get() / maxHp.get()
		end)
		expect(fraction.get()).toBeCloseTo(0.5)
		hp.set(75)
		task.wait()
		expect(fraction.get()).toBeCloseTo(0.25)
		maxHp.set(150)
		task.wait()
		expect(fraction.get()).toBeCloseTo(0.5)
	end)

	it("colors come from the palette only and fonts are the two allowed families", function()
		local color = El.color("HPGreen")
		local rgb = Palette.rgb("HPGreen")
		expect(color.R).toBeCloseTo(rgb[1], 1e-6)
		expect(color.G).toBeCloseTo(rgb[2], 1e-6)
		expect(function()
			El.color("NotAToken")
		end).toThrow("unknown palette token")
		local system = El.font("system", "Bold")
		local lore = El.font("lore")
		expect(typeof(system)).toBe("Font")
		expect(tostring(system)).never.toBe(tostring(lore))
		local label = El.new("TextLabel", { FontFace = system })
		expect(tostring(label.FontFace)).toBe(tostring(system))
	end)

	it("destroy disconnects the listed bindings and removes the instance", function()
		local holder = El.new("Frame", {})
		local label = El.new("TextLabel", { Parent = holder })
		local text = El.state("a")
		local connection = El.bind(label, "Text", text)
		El.destroy(label, { connection })
		expect(connection.Connected).toBe(false)
		expect(label.Parent).toBeNil()
		expect(#holder:GetChildren()).toBe(0)
	end)
end)
