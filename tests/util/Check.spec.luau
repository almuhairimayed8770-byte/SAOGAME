--!strict
local Check = Harness.load("src/shared/util/Check")

describe("Check", function()
	it("number rejects NaN, infinities and out-of-range values", function()
		local checker = Check.number(0, 10)
		expect(checker(5)).toBe(true)
		expect(checker(0 / 0)).toBe(false)
		expect(checker(math.huge)).toBe(false)
		expect(checker(11)).toBe(false)
		expect(checker("5")).toBe(false)
	end)

	it("strictInterface rejects extra and missing fields", function()
		local schema = Check.strictInterface({ artId = Check.string(64), facing = Check.vec3(1.01) })
		expect(schema({ artId = "OneHandedSword.Horizontal", facing = { 0, 0, 1 } })).toBe(true)
		expect(schema({ artId = "OneHandedSword.Horizontal" })).toBe(false)
		expect(schema({ artId = "x", facing = { 0, 0, 1 }, extra = 1 })).toBe(false)
		expect(schema({ artId = "x", facing = { 0, 0, 9 } })).toBe(false)
	end)

	it("array rejects holes and non-integer keys", function()
		local checker = Check.array(Check.integer(), 3)
		expect(checker({ 1, 2, 3 })).toBe(true)
		expect(checker({ 1, 2, 3, 4 })).toBe(false)
		expect(checker({ 1, nil, 3 })).toBe(false)
		expect(checker({ a = 1 })).toBe(false)
	end)

	it("literal, optional and union compose", function()
		local tier = Check.optional(Check.literal("Normal", "Final", "Kill"))
		expect(tier(nil)).toBe(true)
		expect(tier("Kill")).toBe(true)
		expect(tier("Huge")).toBe(false)
		local either = Check.union(Check.boolean, Check.integer())
		expect(either(true)).toBe(true)
		expect(either(3)).toBe(true)
		expect(either(3.5)).toBe(false)
	end)

	it("assert raises with context", function()
		expect(function()
			Check.assert(Check.string(), 5, "weapon name")
		end).toThrow("weapon name")
	end)
end)
