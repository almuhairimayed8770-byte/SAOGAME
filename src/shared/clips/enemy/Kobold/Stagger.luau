--!strict
--[[
	enemy/Kobold/Stagger: the 1.0 s parry stagger (combat.luau parryStagger, F8). It plays on the
	clash frame from the landed chop it answers (key 0 is enemy/Kobold/Overhead at 1.35 s, the
	server's strike, the left foot forward in its stance), blended in over 0.06 s.

	  0.00-0.07  knocked back: the axe arm thrown up and wide, the body arched back over the right
	             leg, the head up, the free arm flung out; the front (left) foot is knocked up off
	             the field. Every part turns at most ~15 deg a frame, out of the chop or the idle.
	  0.07-0.12  held on the clash (3 frames)
	  0.12-0.45  teetering back, still open; the left foot comes down at home behind it (0.45)
	  0.45-0.60  still reeled on both feet (60% of the reel or more until 0.6 s)
	  0.60-1.00  it gathers itself over both feet and settles into the stance by 1.0
	Generated: the legs are rigid blocks (rigs.luau Kobold) solved per key. The right foot never
	leaves its inner front corner (where the chop and the idle both stand it): it only turns on
	that corner to keep its front edge level as the body sways over it. The left foot is knocked
	up off the field, swings back and hovers over its idle place, and comes straight down onto it.
	One key a 60 fps frame.
	Rig: Kobold. Root X+ arches back; Shoulder X+ raises an arm forward and up; Weapon X- tips
	the axe head down.
]]

local Types = require(script.Parent.Parent.Parent.Parent.types)

local function rot(x: number, y: number, z: number): Types.JointKey
	return { rot = { x, y, z } }
end

local function posRot(px: number, py: number, pz: number, rx: number, ry: number, rz: number): Types.JointKey
	return { pos = { px, py, pz }, rot = { rx, ry, rz } }
end

