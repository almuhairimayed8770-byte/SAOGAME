--!strict
--[[
	enemy/Kobold/Break: Guard Break, 3 s (combat.luau breakDuration): the kneel with the weapon
	dropping (section 10), re-keyed so the feet hold the field (D-482). Key 0 and the last key are
	the idle's first key.

	  0.00-0.10  the hit: the body jerks back and onto the left leg, the right foot lifts
	  0.10-0.40  it drops like a weight: the body turns over the planted left hip, 24 degrees forward
	             and 20 down on the right, and the right leg swings back under it and comes down on
	             its toe (0.40, the thud at 0.42); the axe arm goes limp and the axe drops to the dirt,
	             the head hangs
	  0.40-2.30  down: a bounce, then panting (the chest heaves over the left hip, the free arm sways);
	             the axe stays gripped with its head planted on the dirt until 2.37, never under it
	             (D-542: each key's Weapon X solved so the axe block's lowest corner sits 0.01 over
	             the field)
	  2.30-2.92  gets up: the right side comes up off the toe, the body rises past its stance, the
	             right leg swings under it and comes straight down where it stood; the axe comes up
	The left foot never leaves the field: the body turns about the left hip and the left leg keeps
	the idle's angle to the field. The legs are rigid blocks with no knee: the right one "kneels" on
	its front corner, the toe. Generated: one key a 60 fps frame (the right leg's swing solved from
	its hip's height). Rig: Kobold. Root X- slumps forward, Root Z- drops the right side; Hip X-
	swings a leg back; Weapon X- tips the axe head down.
]]

local Types = require(script.Parent.Parent.Parent.Parent.types)

local function rot(x: number, y: number, z: number): Types.JointKey
	return { rot = { x, y, z } }
end

local function posRot(px: number, py: number, pz: number, rx: number, ry: number, rz: number): Types.JointKey
	return { pos = { px, py, pz }, rot = { rx, ry, rz } }
end

