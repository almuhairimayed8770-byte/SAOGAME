--!strict
--[[
	enemy/Kobold/Overhead: the Brute's attack (enemies.luau KoboldAxeman: windUp 1.0, strike
	0.35, recovery 1.4). Section 9: a 1.0 s overhead with a yellow edge; the counter is a parry.

	  0.00-0.52  the wind-up: it steps its left foot forward into a wide stance (planted at 0.34)
	             while the axe is hoisted high behind the head, the body twisting to the right and
	             arching back, the free arm out for balance
	  0.52-1.30  held, breathing, for the rest of the wind-up: readable from behind (the raised
	             axe head, the twisted shoulders); 1.00-1.30 the final loading, a hair higher
	  1.30-1.35  Snap: the chop. The whole body folds down over the planted feet behind the axe.
	  1.35-1.40  Hold, then Settle: the axe bites the ground and rebounds
	  1.30-1.50  hit window: opens on the snap's first frame with the trail and closes in the settle
	             (the server resolves the Brute's cone at windUp + strike = 1.35 s, inside it)
	  1.55-2.75  Recovery: the axe is stuck low; two tugs free it, the left foot steps back
	             (2.36-2.64) and the stance returns
	Generated: the legs are rigid blocks (rigs.luau Kobold: hips at torso (+-0.6, -1.0), legs 2.2
	long) solved per key so each planted foot keeps one bottom corner on the field; the torso's
	height is what the planted legs allow. One key a 60 fps frame, except over the snap and hold.
	Rig: Kobold. Root X+ arches back / X- bends forward; Shoulder X+ raises an arm forward and up;
	Hip X+ swings a leg forward; Weapon X- tips the axe head down.
]]

local Types = require(script.Parent.Parent.Parent.Parent.types)

local function rot(x: number, y: number, z: number): Types.JointKey
	return { rot = { x, y, z } }
end

local function posRot(px: number, py: number, pz: number, rx: number, ry: number, rz: number): Types.JointKey
	return { pos = { px, py, pz }, rot = { rx, ry, rz } }
end

