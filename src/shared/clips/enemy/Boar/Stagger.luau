--!strict
--[[
	enemy/Boar/Stagger: the 1.0 s parry stagger (combat.luau parryStagger), re-keyed so the feet hold
	the field (D-482). Key 0 and the last key are the idle's first key.

	  0.00-0.10  rears up on its back legs, the body turning 17 degrees nose-up about the back hips,
	             the front feet pawing forward, the jaw open, the head thrown up, the tail up
	  0.10-0.20  hangs in the air, the front legs paddling
	  0.20-0.40  crashes down, falling like a weight; the front legs swing back under it on the way
	             and land flat where they stood (0.40, the footstep at 0.42); the head snaps down
	  0.44-0.74  sways onto its left legs (the right feet lift and come straight back down)
	  0.44-1.00  shakes its head and settles into the idle stance
	The back feet never leave the field: the body turns about the back hips and every back leg keeps
	the idle's angle to the field. Generated: one key a 60 fps frame. Rig: Boar. Root X+ pitches the
	nose up; Hip X+ swings a leg forward; Neck X- lowers the head; Tail X- lifts it.
]]

local Types = require(script.Parent.Parent.Parent.Parent.types)

local function rot(x: number, y: number, z: number): Types.JointKey
	return { rot = { x, y, z } }
end

local function posRot(px: number, py: number, pz: number, rx: number, ry: number, rz: number): Types.JointKey
	return { pos = { px, py, pz }, rot = { rx, ry, rz } }
end

