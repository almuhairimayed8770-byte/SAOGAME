--!strict
--[[
	enemy/Boar/Break: Guard Break, 3 s (combat.luau breakDuration): the kneel (section 10), re-keyed
	so the feet hold the field (D-482). Key 0 and the last key are the idle's first key.

	  0.00-0.10  the hit: the body jerks 3 degrees nose-up about the back hips, lifting the front
	             feet, and the front legs start to fold back
	  0.10-0.40  the front end drops like a weight, 25 degrees nose-down about the back hips; the front
	             legs fold back under the chest as the hips come down and land folded on the field
	             with the chest (0.40, the thud at 0.42); the head goes down to the dirt, the tail
	             droops
	  0.40-2.35  down: a bounce on the chest, then panting (the body heaves on the back hips, the jaw
	             works); the folded front legs rest on the field
	  2.35-2.95  gets up: the front end pushes up past standing, the front legs swing under it and
	             come straight down onto the field where they stood
	The back feet never leave the field: the body turns about the back hips and every back leg keeps
	the idle's angle to the field. Generated: one key a 60 fps frame (a front leg's fold solved from
	its hip's height). Rig: Boar. Root X- pitches the nose down; Hip X- folds a leg back.
]]

local Types = require(script.Parent.Parent.Parent.Parent.types)

local function rot(x: number, y: number, z: number): Types.JointKey
	return { rot = { x, y, z } }
end

local function posRot(px: number, py: number, pz: number, rx: number, ry: number, rz: number): Types.JointKey
	return { pos = { px, py, pz }, rot = { rx, ry, rz } }
end

