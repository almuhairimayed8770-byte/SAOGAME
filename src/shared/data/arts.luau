-- ---------------------------------------------------------------------------------------------
-- Helpers
-- ---------------------------------------------------------------------------------------------

local Arts = {}

Arts.rows = rows

-- Rules around Arts that are numbers (sections 7 and 13), not rows.
Arts.rules = {
	proficiencyMax = 1000,
	proficiencyPerArtHitMax = 3, -- an Art that lands gives 1 to 3 points, scaled down as proficiency rises
	proficiencyPerArtHitMin = 1,
	proficiencyPerParry = 2,
	twinFangActivationHold = 0.2, -- every Twin Fang Art holds its activation this long (punishable)
	twinFangGaugeMultiplier = 2.5, -- Twin Fang hits count as two Art hits for Guard Gauge purposes
	twinFangWhiffPostMotionMultiplier = 2, -- doubled post-motion when a Twin Fang Art hits nothing
	flashdrawPostMotionMultiplier = 1.3, -- Flashdraw origin: Katana Arts skip the start pose, +30% post-motion
	momentumStartPoseCut = 0.5, -- Striker Momentum: each landed Art cuts the next start pose by half
	momentumMaxStacks = 3,
	breakerGaugeBonus = 0.6, -- Breaker Shatter: +60% Guard Gauge damage
	shadeFirstStrikeMultiplier = 2.5, -- Shade: first strike from behind
}

local listCache: { [string]: { Art } } = {}

--- The Art with this id, or nil when the id is unknown (CombatService rejects the request).
function Arts.byId(id: string): Art?
	return rows[id]
end

--- Every Art of a weapon category, sorted by unlock then name (a stable, readable order).
function Arts.list(weapon: Types.WeaponCategory): { Art }
	local cached = listCache[weapon]
	if cached ~= nil then
		return table.clone(cached)
	end
	local list = {}
	for _, art in rows do
		if art.weapon == weapon then
			table.insert(list, art)
		end
	end
	table.sort(list, function(a, b)
		if a.unlock ~= b.unlock then
			return a.unlock < b.unlock
		end
		return a.name < b.name
	end)
	listCache[weapon] = list
	return table.clone(list)
end

--- The Arts a character with this proficiency has unlocked in a weapon category, sorted by unlock.
function Arts.forProficiency(weapon: Types.WeaponCategory, proficiency: number): { Art }
	local unlocked = {}
	for _, art in Arts.list(weapon) do
		if art.unlock <= proficiency then
			table.insert(unlocked, art)
		end
	end
	return unlocked
end

--- Number of Arts in a weapon category, or in the whole table when no weapon is given.
function Arts.count(weapon: Types.WeaponCategory?): number
	if weapon ~= nil then
		return #Arts.list(weapon)
	end
	local total = 0
	for _ in rows do
		total += 1
	end
	return total
end

--- Every weapon category that has at least one Art, sorted.
function Arts.weapons(): { Types.WeaponCategory }
	local seen: { [string]: boolean } = {}
	local weapons = {}
	for _, art in rows do
		if not seen[art.weapon] then
			seen[art.weapon] = true
			table.insert(weapons, art.weapon)
		end
	end
	table.sort(weapons)
	return weapons
end

--- Proficiency points a landed Art gives at the current proficiency: 3 at 0 falling to 1 at the cap.
function Arts.proficiencyGain(proficiency: number): number
	local rules = Arts.rules
	local fraction = math.clamp(proficiency / rules.proficiencyMax, 0, 1)
	local span = rules.proficiencyPerArtHitMax - rules.proficiencyPerArtHitMin
	return math.floor(rules.proficiencyPerArtHitMax - span * fraction + 0.5)
end

--- True when the Art can be picked from this stance (no preconditions means any stance).
function Arts.allowedFrom(art: Art, stance: Types.Precondition): boolean
	if art.preconditions == nil then
		return true
	end
	return table.find(art.preconditions, stance) ~= nil
end

return Arts
