			{
				id = "Lunge",
				name = "Lunge",
				telegraph = "Normal",
				windUp = 0.5,
				strike = 0.3,
				recovery = 1.0,
				multiplier = 1.4,
				gaugeDamage = 15,
				reach = 8,
				arc = 0,
				clip = "Lunge",
