		description = "Field boss. A Legion officer who walked off the wall; a full 1H Sword Art list and a Mirror Shield.",
	},
}

-- ---------------------------------------------------------------------------------------------
-- Helpers
-- ---------------------------------------------------------------------------------------------

Enemies.rows = rows

local function round(value: number): number
	return math.floor(value + 0.5)
end

local function cloneWithAttacks(def: Enemy): Enemy
	local copy = table.clone(def)
	local attacks = {}
	for _, attack in def.attacks do
		table.insert(attacks, table.clone(attack))
	end
	copy.attacks = attacks
	if def.arts ~= nil then
		copy.arts = table.clone(def.arts)
	end
	return copy
end

--- The enemy row with this id (tier-1 base values), or nil.
function Enemies.byId(id: string): Enemy?
	return rows[id]
end

--- Every row, or every row of one floor, sorted by floor then band (Verge, Reach, Blight) then name.
function Enemies.list(floor: number?): { Enemy }
	local bandOrder = { Verge = 1, Reach = 2, Blight = 3 }
	local list = {}
	for _, def in rows do
		if floor == nil or def.floor == floor then
			table.insert(list, def)
		end
	end
	table.sort(list, function(a, b)
		if a.floor ~= b.floor then
			return a.floor < b.floor
		end
		if bandOrder[a.band] ~= bandOrder[b.band] then
			return bandOrder[a.band] < bandOrder[b.band]
		end
		return a.name < b.name
	end)
	return list
end

--- The regular (non field boss) enemies of a floor, for spawn tables.
function Enemies.forFloor(floor: number): { Enemy }
	local list = {}
	for _, def in Enemies.list(floor) do
		if not def.fieldBoss then
			table.insert(list, def)
		end
	end
	return list
end

--- The field boss of a floor, or nil.
function Enemies.fieldBoss(floor: number): Enemy?
	for _, def in rows do
		if def.floor == floor and def.fieldBoss then
			return def
		end
	end
	return nil
end

--- A copy of the row with its floor tier (and the field-boss multiplier) applied: what EnemyService spawns.
function Enemies.scaled(def: Enemy): Enemy
	local copy = cloneWithAttacks(def)
	local tier = Tiers.get(def.tier)
	local rules = Enemies.rules
	local statMultiplier = if def.fieldBoss then rules.eliteStatMultiplier * rules.fieldBossEliteMultiplier else 1
	copy.hp = round(def.hp * tier.hp * statMultiplier)
	copy.attack = def.attack * tier.attack * statMultiplier
	copy.defense = round(def.defense * tier.defense * statMultiplier)
	copy.guardGauge = round(def.guardGauge * tier.gauge * statMultiplier)
	copy.xp = Tiers.scaleXp(def.xp * statMultiplier, def.tier)
	return copy
end

--- A scaled copy for a variant: Elite (1.5x stats, Mirror Shield, a second attack), Night (+25% damage,
--- glowing eyes) or Gilded (5x HP, a guaranteed Rare). Variants stack; apply Night after Elite on a Blood Moon.
function Enemies.variant(def: Enemy, kind: VariantKind): Enemy
	local copy = cloneWithAttacks(def)
	local rules = Enemies.rules
	if kind == "Elite" then
		local m = rules.eliteStatMultiplier
		copy.hp = round(def.hp * m)
		copy.attack = def.attack * m
		copy.defense = round(def.defense * m)
		copy.guardGauge = round(def.guardGauge * m)
		copy.xp = round(def.xp * m)
		copy.elite = true
		copy.mirrorShield = true
		copy.name = "Elite " .. def.name
		local extra = Enemies.eliteAttacks[def.archetype]
		if extra ~= nil then
			local present = false
			for _, attack in copy.attacks do
				if attack.id == extra.id then
					present = true
					break
				end
			end
			if not present then
				table.insert(copy.attacks, table.clone(extra))
			end
		end
	elseif kind == "Night" then
		copy.attack = def.attack * rules.nightDamageMultiplier
		copy.night = true
		copy.name = "Night " .. def.name
	elseif kind == "Gilded" then
		copy.hp = round(def.hp * rules.gildedHpMultiplier)
		copy.gilded = true
		copy.guaranteedRare = true
		copy.name = "Gilded " .. def.name
	else
		error(("Enemies.variant: unknown variant '%s'"):format(tostring(kind)))
	end
	copy.variant = kind
	return copy
end

--- Every rig id the rows reference, sorted and unique.
function Enemies.rigIds(): { string }
	local seen: { [string]: boolean } = {}
	local ids = {}
	for _, def in rows do
		if not seen[def.skin] then
			seen[def.skin] = true
			table.insert(ids, def.skin)
		end
	end
	table.sort(ids)
	return ids
end

--- Number of rows, or rows on one floor.
function Enemies.count(floor: number?): number
	return #Enemies.list(floor)
end

return Enemies
