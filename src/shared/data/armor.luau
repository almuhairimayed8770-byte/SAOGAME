--!strict
--[[
	Armor (sections 6, 12, 13). The Trialist cloth set every character starts in, the floor 1 drop
	pieces, and the floor 1 Apex set (the Mantle of Last Light is a coat, so it is an OverLayer here,
	not a weapon). Defense is flat damage reduction (section 6). Weight counts against the STR
	weight limit and heavy pieces cut AGI; the weight classes below fix the penalty per piece so a
	full heavy set costs a known amount of AGI.

	Accessories are armor rows with zero defense and a `bonus` table; the HUD and DamageMath read
	the bonus keys they know (critChance, maxHpFraction, guardGaugeFraction).
]]

local Types = require(script.Parent.Parent.types)

export type WeightClass = "Light" | "Medium" | "Heavy"
export type ArmorSource = "LAB" | "FieldBoss" | "MiniDungeon" | "Smith" | "Drop" | "Vendor"

export type Armor = Types.ArmorDef & {
	weightClass: WeightClass,
	source: ArmorSource?,
	description: string?,
	bonus: { [string]: number }?, -- accessory effects, fractions
}

local Armor = {}

-- Weight classes: the AGI each piece costs and the heaviest a piece of the class may be.
Armor.weightClasses = {
	Light = { agiPenalty = 0, maxWeight = 2 },
	Medium = { agiPenalty = 1, maxWeight = 4 },
	Heavy = { agiPenalty = 2, maxWeight = 8 },
} :: { [WeightClass]: { agiPenalty: number, maxWeight: number } }

-- Section 12 armor layers, bottom to top; the slots a set can fill.
Armor.slots = { "Chest", "Legs", "Hands", "Boots", "Head", "OverLayer", "Accessory" } :: { Types.EquipSlot }

