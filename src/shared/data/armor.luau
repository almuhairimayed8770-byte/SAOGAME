-- Helpers
-- ---------------------------------------------------------------------------------------------

Armor.rows = rows

-- The starting outfit by slot.
Armor.trialistSet = {
	Chest = "TrialistTunic",
	Legs = "TrialistTrousers",
	Hands = "TrialistGloves",
	Boots = "TrialistBoots",
	Head = "TrialistHood",
} :: { [Types.EquipSlot]: string }

--- The armor piece with this id, or nil when unknown.
function Armor.byId(id: string): Armor?
	return rows[id]
end

--- Every piece, or every piece of one slot, sorted by floor then defense then name.
function Armor.list(slot: Types.EquipSlot?): { Armor }
	local list = {}
	for _, piece in rows do
		if slot == nil or piece.slot == slot then
			table.insert(list, piece)
		end
	end
	table.sort(list, function(a, b)
		if a.floor ~= b.floor then
			return a.floor < b.floor
		end
		if a.defense ~= b.defense then
			return a.defense < b.defense
		end
		return a.name < b.name
	end)
	return list
end

--- Every piece of a set id (Apex sets), sorted by slot name.
function Armor.set(setId: string): { Armor }
	local list = {}
	for _, piece in rows do
		if piece.set == setId then
			table.insert(list, piece)
		end
	end
	table.sort(list, function(a, b)
		return a.slot < b.slot
	end)
	return list
end

--- Flat defense, total weight and AGI penalty of a list of equipped armor ids (unknown ids are skipped).
function Armor.totals(equippedIds: { string }): { defense: number, weight: number, agiPenalty: number }
	local totals = { defense = 0, weight = 0, agiPenalty = 0 }
	for _, id in equippedIds do
		local piece = rows[id]
		if piece ~= nil then
			totals.defense += piece.defense
			totals.weight += piece.weight
			totals.agiPenalty += piece.agiPenalty
		end
	end
	return totals
end

return Armor
