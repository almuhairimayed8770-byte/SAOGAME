--!strict
--[[
	SmokeRunner: builds the script tools/smoke.sh hands to run-in-roblox for one smoke script.

	run-in-roblox runs its script inside a plugin, at plugin security, with the place in Edit mode:
	nothing in ServerScriptService runs, so Main.server.luau never starts the services and a smoke
	script that waits for them times out. The runner this module writes bridges that gap. It
	installs the smoke script's source as a server Script in ServerScriptService, starts a Run
	session (Studio's Run button: the edit DataModel simulates with physics and server scripts, no
	player), waits until the smoke script reaches its last line, raises an error, or runs out of
	time, and prints one result line:

		SMOKE-RESULT: PASS <name>
		SMOKE-RESULT: FAIL <name>: <reason>

	tools/smoke.sh reads that line instead of run-in-roblox's exit code, which turns red on any
	error Studio prints (its own plugins included).

	Pure: no requires, so tools/smoke-wrap.luau and the Lune spec load it directly.
]]

local SmokeRunner = {}

--- The result line prefix tools/smoke.sh greps for.
SmokeRunner.resultPrefix = "SMOKE-RESULT:"

--- Workspace attribute the installed smoke script sets on its last line.
SmokeRunner.doneAttribute = "SkyspireSmokeDone"

--- Seconds a smoke script may run before the runner reports it as timed out (tooling budget,
--- not a game number: the slowest script, perf.smoke, samples for well under a minute).
SmokeRunner.defaultTimeoutSeconds = 240

--- Seconds between the runner's checks while the smoke script runs.
SmokeRunner.pollSeconds = 0.25

--- The smoke script's name: its file name without the directory and the ".luau" extension
--- (tests/smoke/combat.smoke.luau -> "combat.smoke"), which is also the "[combat.smoke]" prefix
--- its check() helper writes into every failure.
function SmokeRunner.nameOf(path: string): string
	local file = path:match("([^/\\]+)$") or path
	return (file:gsub("%.luau$", ""))
end

--- The shortest long-bracket level whose closing bracket does not appear in the source.
function SmokeRunner.bracketLevel(source: string): number
	local level = 0
	while source:find("]" .. string.rep("=", level) .. "]", 1, true) ~= nil do
		level += 1
	end
	return level
end

--- Wraps text in a long string literal that reproduces it exactly (the newline after the opening
--- bracket is dropped by the parser, so the text keeps its own first line).
function SmokeRunner.longString(text: string): string
	local equals = string.rep("=", SmokeRunner.bracketLevel(text))
	return "[" .. equals .. "[\n" .. text .. "]" .. equals .. "]"
end

--- The line appended to the smoke script so the runner knows it reached the end.
function SmokeRunner.doneLine(): string
	return ('\nworkspace:SetAttribute("%s", true)\n'):format(SmokeRunner.doneAttribute)
end

local TEMPLATE = [=[
--!strict
-- Generated by tools/smoke-wrap.luau from {{PATH}}. Do not edit; rerun tools/smoke.sh.
-- run-in-roblox runs this at plugin security in Edit mode. It installs the smoke script as a
-- server Script, starts a Run session so Main.server.luau and the smoke script run as they would
-- on a server, waits for the smoke script to finish, and prints one SMOKE-RESULT line.

local LogService = game:GetService("LogService")
local RunService = game:GetService("RunService")
local ScriptContext = game:GetService("ScriptContext")
local ServerScriptService = game:GetService("ServerScriptService")

local NAME = {{NAME}}
local PREFIX = {{PREFIX}}
local DONE_ATTRIBUTE = {{DONE}}
local TIMEOUT = {{TIMEOUT}}
local POLL = {{POLL}}
local SOURCE = {{SOURCE}}
local DONE_LINE = {{DONE_LINE}}

workspace:SetAttribute(DONE_ATTRIBUTE, nil)

local smoke = Instance.new("Script")
smoke.Name = NAME
local writable: any = smoke -- Source is writable at plugin security only
writable.Source = SOURCE .. DONE_LINE
smoke.Parent = ServerScriptService

local failure: string? = nil
local tag = "[" .. NAME .. "]"

-- A script error, reported with the script it came from (pcall: if this Studio build refuses the
-- connection at plugin security, the tagged-output fallback below still catches check() failures).
local errorConnected, errorConnection = pcall(function()
	return ScriptContext.Error:Connect(function(message: string, trace: string, origin: Instance?)
		if origin == smoke and failure == nil then
			failure = message .. "\n" .. trace
		end
	end)
end)
if not errorConnected then
	print(("%s note: ScriptContext.Error unavailable here (%s); relying on tagged output"):format(PREFIX, tostring(errorConnection)))
end
-- Fallback: the smoke script's own check() failures carry its [name] tag.
local logConnection = LogService.MessageOut:Connect(function(message: string, kind: Enum.MessageType)
	if kind == Enum.MessageType.MessageError and failure == nil and string.find(message, tag, 1, true) ~= nil then
		failure = message
	end
end)

print(("%s starting a Run session for %s"):format(PREFIX, NAME))
local started, startError = pcall(function()
	RunService:Run()
end)
if not started then
	failure = "could not start a Run session: " .. tostring(startError)
end

local elapsed = 0
while workspace:GetAttribute(DONE_ATTRIBUTE) ~= true and failure == nil and elapsed < TIMEOUT do
	elapsed += task.wait(POLL)
end

if errorConnected then
	errorConnection:Disconnect()
end
logConnection:Disconnect()

if failure ~= nil then
	print(("%s FAIL %s: %s"):format(PREFIX, NAME, failure))
elseif workspace:GetAttribute(DONE_ATTRIBUTE) == true then
	print(("%s PASS %s"):format(PREFIX, NAME))
else
	print(("%s FAIL %s: timed out after %d s without reaching its last line"):format(PREFIX, NAME, TIMEOUT))
end

pcall(function()
	RunService:Stop()
end)
]=]

export type Options = {
	path: string, -- the smoke script's repo-relative path, for the generated header
	source: string, -- the smoke script's source
	timeoutSeconds: number?, -- defaults to SmokeRunner.defaultTimeoutSeconds
}

local function quote(text: string): string
	return ("%q"):format(text)
end

--- The runner source for one smoke script.
function SmokeRunner.build(options: Options): string
	local name = SmokeRunner.nameOf(options.path)
	local timeout = options.timeoutSeconds or SmokeRunner.defaultTimeoutSeconds
	assert(timeout > 0, "SmokeRunner: timeoutSeconds must be positive")
	local fields: { [string]: string } = {
		PATH = options.path,
		NAME = quote(name),
		PREFIX = quote(SmokeRunner.resultPrefix),
		DONE = quote(SmokeRunner.doneAttribute),
		TIMEOUT = tostring(timeout),
		POLL = tostring(SmokeRunner.pollSeconds),
		SOURCE = SmokeRunner.longString(options.source),
		DONE_LINE = quote(SmokeRunner.doneLine()),
	}
	-- One pass over the template; a function replacement is used verbatim, so nothing in the
	-- smoke source is read as a pattern or rescanned for tokens.
	local out = TEMPLATE:gsub("{{([%u_]+)}}", function(key: string): string
		local value = fields[key]
		assert(value ~= nil, "SmokeRunner: unknown template field " .. key)
		return value
	end)
	return out
end

return SmokeRunner
